      "source": [
        "ipc_tasa = 0.0510  # 5.10%\n",
        "\n",
        "datos = {\n",
        "    \"Area Comun\": 5_000_000_000,\n",
        "    \"ELec\": 10_000_000,\n",
        "    \"Maqui\": 10_000_000,\n",
        "    \"Mu\": 15_000_000\n",
        "}\n",
        "\n",
        "print(f\"{'País':<6} | {'Base':<16} | {'IPC (5.10%)':<16} | {'Total':<16}\")\n",
        "print(\"-\" * 60)\n",
        "\n",
        "for pais, base in datos.items():\n",
        "    ipc_valor = base * ipc_tasa\n",
        "    total = base + ipc_valor\n",
        "    print(f\"{pais:<6} | {base:>16,.2f} | {ipc_valor:>16,.2f} | {total:>16,.2f}\")\n"
      ],
